---
import PrimaryButton from './PrimaryButton.astro';
import SecondaryButton from './SecondaryButton.astro';
---

<div class="hero">
    <div class="hero-inner">
        <div class="copy">
            <h1>Open English Translation (OET)</h1>
            <p class="introduction">
                Read a freely licensed Bible translation with a modern-English{
                    ' '
                }
                <strong>Readers’ Version</strong> alongside a <strong
                    >Literal Version</strong
                > that helps you explore the original Hebrew, Aramaic, and Greek.
            </p>
            <p class="tagline">
                A new, exciting, radical, freely-licensed Bible translation for
                the 2030s.
            </p>
            <div class="buttons">
                <PrimaryButton href="/Reader">Read the OET</PrimaryButton>
                <SecondaryButton href="/Intro/Overview"
                    >Learn about the OET</SecondaryButton
                >
            </div>
            <p class="status">
                The OET is an unfinished draft undergoing consistency and
                accuracy checks. <a href="/About/Status"
                    >See the current status</a
                >.
            </p>
        </div>
        <img
            class="image"
            src="/assets/sixteen-miles-out-MLOZazGGCb8-unsplash.jpg"
            alt="Picture of an open Bible"
        />
    </div>
</div>

<style>
    .hero {
        display: flex;
        width: 100%;
        background-color: var(--accent-orange-light);
    }

    .hero-inner {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
        max-width: var(--max-width);
        padding: 3rem 0.5rem;
        margin: 0 auto;
        gap: 3rem;
        width: 100%;
    }

    .copy {
        flex: 1;
        min-width: 0;
    }

    h1 {
        margin: 0;
        font-size: 2.5rem;
        line-height: 3.1rem;
        letter-spacing: -0.006rem;
        font-weight: 600;
        color: var(--medium-blue);
    }

    .introduction {
        margin: 1rem 0;
        font-size: 1.125rem;
        line-height: 1.6;
    }

    .tagline {
        margin: 1rem 0;
        line-height: 1.5;
    }

    .status {
        margin: 1rem 0 0;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .buttons {
        margin-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .image {
        object-fit: contain;
        height: auto;
        width: 100%;
    }

    @media (min-width: 767px) {
        .hero-inner {
            flex-direction: row;
            align-items: center;
            text-align: left;
        }

        .buttons {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .image {
            width: 42%;
        }
    }
</style>
