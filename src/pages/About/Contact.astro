---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Page from '../../components/Page.astro';
import MainPageContent from '../../components/MainPageContent.astro';
---

<Base title="Contact - Open English Translation">
    <Header />
    <main class="main">
        <Page>
            <MainPageContent>
                <h1>Contacting the Editors</h1>
                <p>
                    The <em>Open English Translation</em> of the Bible is a product
                    of <a href="https://Freely-Given.org">Freely-Given.org</a>.
                    It is offered to the world as a free gift in the same way
                    that the original scriptures were created without thought of
                    profit. To contact the editors with corrections or
                    suggestions, please email <b>OET</b> (dot) <b>Bible</b> (at) <b
                        >gmail</b
                    > (dot) <b>com</b>. <small
                        >(All <em>OET</em> submissions become the property of <a
                            href="https://Freely-Given.org">Freely-Given.org</a
                        >—see below.)</small
                    >
                </p>
                <p>
                    Note: Of course you don’t need to contact us to request
                    permission to use the Open English Translation—that
                    permission is granted in advance! (See the <a
                        href="/About/Licence">Licence page</a
                    >.)
                </p>
                <section
                    class="newsletter"
                    aria-labelledby="newsletter-heading"
                >
                    <div class="newsletter-intro">
                        <h2 id="newsletter-heading">
                            Stay in touch with the OET
                        </h2>
                        <p>
                            Subscribe to our newsletter on Substack for news and
                            updates about the Open English Translation.
                        </p>
                        <p class="newsletter-alternative">
                            You can also <a
                                href="https://oetbible.substack.com/subscribe"
                                >sign up directly on Substack</a
                            >.
                        </p>
                    </div>
                    <iframe
                        class="newsletter-form"
                        src="https://oetbible.substack.com/embed"
                        title="Subscribe to the OET newsletter on Substack"
                        width="480"
                        height="320"
                        loading="lazy"></iframe>
                </section>
                <h1>Volunteering</h1>
                <p>
                    We’re currently looking for volunteers to help with this
                    work. This includes both Bible people (translators and
                    consultants and readers and checkers) as well as software
                    people (developers and designers). There are more details on
                    the <a href="/About/Partners">Partners page</a>.
                </p>
                <p>
                    Any volunteers must agree in writing in advance that their
                    work will become the property of Freely-Given.org, and thus
                    made publicly available under an <a href="/About/Licence"
                        >open licence</a
                    >. Of course we’re happy to credit any contributors (unless
                    they wish to remain anonymous).
                </p>
                <p>
                    <small>
                        We are very interested in having those join us who are
                        retired or otherwise financially self-supported but we
                        are also aware that there might be younger volunteers
                        who are interested to help with a great project but
                        still need to feed their families. If that’s you,
                        contact us anyway and we may be able to find a way to
                        help with a small honorarium.
                    </small>
                </p>
            </MainPageContent>
        </Page>
    </main>
    <Footer />
</Base>

<style>
    .main {
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .newsletter {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        gap: 1.5rem;
        margin: 2.5rem 0;
        padding: clamp(1rem, 3vw, 2rem);
        border-top: 4px solid var(--accent-orange);
        border-radius: 5px;
        background-color: var(--accent-orange-light);
    }

    .newsletter h2 {
        margin-top: 0;
        font-size: 1.75rem;
        font-weight: 600;
        line-height: 1.25;
        text-wrap: balance;
    }

    .newsletter .newsletter-alternative {
        font-size: 1rem;
    }

    .newsletter a:focus-visible {
        outline: 3px solid var(--medium-blue);
        outline-offset: 4px;
    }

    .newsletter .newsletter-form {
        display: block;
        width: 100%;
        max-width: 30rem;
        height: 320px;
        margin: 0 auto;
        border: 0;
        border-radius: 5px;
        background-color: #fff;
    }

    @media (min-width: 800px) {
        .newsletter {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
            gap: 2rem;
        }
    }
</style>
