---
import downloadCatalogue from '../../data/oet-pdfs.json';
type PDFFile = {
    url: string;
    filename: string;
    bytes: number;
    pages: number;
    medium: 'print' | 'screen';
    paper_size: string;
};
type PDFEntry = {
    id: string;
    title: string;
    group: string;
    kind: 'collection' | 'book';
    files: PDFFile[];
};
type PDFCatalogue = {
    schema_version: number;
    draft_version: string;
    groups: { id: string; title: string }[];
    editions: { id: string; label: string; entries: PDFEntry[] }[];
};
const catalogue = downloadCatalogue as PDFCatalogue;
if (catalogue.schema_version !== 2)
    throw new Error('Unsupported PDF download catalogue version');
const displayTitle = (entry: PDFEntry) =>
    entry.kind === 'book' ? `${entry.title} (${entry.id})` : entry.title;
const size = (file: PDFFile) => `${(file.bytes / 1048576).toFixed(1)} MB`;
const editions = catalogue.editions.map((edition) => ({
    ...edition,
    sections: [
        {
            title: 'Collections',
            books: edition.entries.filter((e) => e.kind === 'collection'),
            expandable: false,
        },
        ...catalogue.groups.map((group) => ({
            title: group.title,
            books: edition.entries.filter(
                (e) => e.kind === 'book' && e.group === group.id,
            ),
            expandable: true,
        })),
    ],
}));
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Page from '../../components/Page.astro';
import MainPageContent from '../../components/MainPageContent.astro';
---

<Base title="Downloads - Open English Translation">
    <Header />
    <main class="main">
        <Page
            ><MainPageContent>
                <h1>Downloads</h1>
                <h1 id="pdfs">PDFs</h1>
                <p>
                    Download the Open English Translation in OET book order:
                    choose the parallel Readers’ and Literal Versions, or the
                    Readers’ Version alone with a full-width introduction and
                    two-column Bible text. These are translation drafts ({
                        catalogue.draft_version
                    }), hosted on Freely-Given.org/OBD.
                </p>
                <p>
                    <strong>Print</strong> PDFs use black-and-white text and full
                    web addresses, with B5, A4 and Letter paper choices. <strong
                        >Online</strong
                    > PDFs use B5 pages, colour and live links. All PDFs have clickable
                    links. For printing, use actual size, double-sided, with long-edge
                    binding.
                </p>
                <p>
                    Deuterocanonical and other books include early drafts. In
                    parallel editions, the versions are paired by chapter; their
                    verses and lines do not necessarily correspond. Missing
                    versions are identified in those PDFs. Readers’ Version
                    downloads include only books available in that version.
                </p>
                <nav aria-label="PDF editions" class="edition-links">
                    {
                        editions.map((edition) => (
                            <a href={`#${edition.id}`}>{edition.label}</a>
                        ))
                    }
                </nav>
                {
                    editions.map((edition) => (
                        <section class="pdf-edition" id={edition.id}>
                            <h2>
                                {edition.label} ({edition.id})
                            </h2>
                            {edition.sections.map((section) => {
                                const Wrapper = section.expandable
                                    ? 'details'
                                    : 'div';
                                return (
                                    <Wrapper>
                                        {section.expandable && (
                                            <summary>
                                                {section.title} (
                                                {section.books.length} books)
                                            </summary>
                                        )}
                                        <div class="pdf-table-wrap">
                                            <table class="pdf-table">
                                                <caption>
                                                    {section.title}
                                                </caption>
                                                <thead>
                                                    <tr>
                                                        <th scope="col">
                                                            Title
                                                        </th>
                                                        <th scope="col">
                                                            Print
                                                        </th>
                                                        <th scope="col">
                                                            Online
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    {section.books.map(
                                                        (entry) => (
                                                            <tr>
                                                                <th scope="row">
                                                                    {displayTitle(
                                                                        entry,
                                                                    )}
                                                                </th>
                                                                {(
                                                                    [
                                                                        'print',
                                                                        'screen',
                                                                    ] as const
                                                                ).map(
                                                                    (
                                                                        medium,
                                                                    ) => (
                                                                        <td>
                                                                            {entry.files
                                                                                .filter(
                                                                                    (
                                                                                        file,
                                                                                    ) =>
                                                                                        file.medium ===
                                                                                        medium,
                                                                                )
                                                                                .map(
                                                                                    (
                                                                                        file,
                                                                                    ) => (
                                                                                        <div class="pdf-choice">
                                                                                            <a
                                                                                                href={
                                                                                                    file.url
                                                                                                }
                                                                                                aria-label={`${displayTitle(entry)} — ${edition.label} — ${medium === 'print' ? 'Print' : 'Online'} ${file.paper_size} PDF`}
                                                                                            >
                                                                                                {
                                                                                                    file.paper_size
                                                                                                }{' '}
                                                                                                PDF
                                                                                            </a>
                                                                                            <small>
                                                                                                {size(
                                                                                                    file,
                                                                                                )}{' '}
                                                                                                ·{' '}
                                                                                                {file.pages.toLocaleString(
                                                                                                    'en',
                                                                                                )}{' '}
                                                                                                pages
                                                                                            </small>
                                                                                        </div>
                                                                                    ),
                                                                                )}
                                                                        </td>
                                                                    ),
                                                                )}
                                                            </tr>
                                                        ),
                                                    )}
                                                </tbody>
                                            </table>
                                        </div>
                                    </Wrapper>
                                );
                            })}
                        </section>
                    ))
                }
                <h1 id="paratext">Paratext backups</h1>
                <p>
                    The <a href="https://paratext.org/"
                        >UBS/SIL Paratext Bible editor</a
                    > has the ability to load a project from a zip file. We provide
                    the following snapshots of the OET v0.48.78:
                </p>
                <ul>
                    <li>
                        <a href="/Paratext_backups/OET_RV_F 2026-09-14.zip"
                            >Readers’ Version (full version)</a
                        >
                    </li>
                    <li>
                        <a href="/Paratext_backups/OET_RV_E 2026-09-14.zip"
                            >Readers’ Version (without word numbers, etc.)</a
                        >
                    </li>
                    <li>
                        <a href="/Paratext_backups/OET_LV_F 2026-09-14.zip"
                            >Literal Version (full version)</a
                        >
                    </li>
                    <li>
                        <a href="/Paratext_backups/OET_LV_E 2026-09-14.zip"
                            >Literal Version (without word numbers, etc.)</a
                        >
                    </li>
                </ul>
                <h1 id="source">Source files</h1>
                <p>
                    The in-progress source files of the <em>OET</em> are <a
                        href="https://github.com/Freely-Given-org/ESFM">ESFM</a
                    > (enhanced <a
                        href="https://docs.usfm.bible/usfm/latest/index.html"
                        >USFM</a
                    >) and associated ESFM data tables are <a
                        href="https://en.Wikipedia.org/wiki/Tab-separated_values"
                        >TSV</a
                    >. These can be downloaded from the <a
                        href="https://GitHub.com/Freely-Given-org/OpenEnglishTranslation--OET"
                        >project repository</a
                    >.
                </p>
            </MainPageContent>
        </Page>
    </main>
    <Footer />
</Base>

<style>
    .main {
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .main :global(.main-page-content) {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
    }
    .pdf-table-wrap {
        overflow-x: auto;
    }
    .pdf-table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
    }
    .pdf-table caption {
        text-align: left;
        font-weight: 600;
        padding: 1rem 0;
        font-size: 1.2rem;
    }
    .pdf-table th,
    .pdf-table td {
        padding: 0.7rem 0.5rem;
        text-align: left;
        border-bottom: 1px solid #d5dce0;
        vertical-align: top;
    }
    .pdf-table th:first-child {
        width: 42%;
    }
    .pdf-table tbody th {
        font-weight: 500;
    }
    .pdf-choice {
        margin-bottom: 0.8rem;
    }
    .pdf-choice small {
        display: block;
        margin-top: 0.2rem;
    }
    .pdf-edition {
        margin-top: 2.5rem;
    }
    .pdf-edition details {
        margin: 1rem 0;
    }
    .pdf-edition summary {
        cursor: pointer;
        font-weight: 600;
        padding: 0.5rem 0;
    }
    .edition-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
    }
</style>
