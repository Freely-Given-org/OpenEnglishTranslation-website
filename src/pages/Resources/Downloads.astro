---
import downloadCatalogue from '../../data/oet-pdfs.json';
type PDFFile = {
    url: string;
    filename: string;
    bytes: number;
    pages: number;
    medium: 'print' | 'screen';
    paper_size: string;
};
type PDFEntry = {
    id: string;
    title: string;
    group: string;
    kind: 'collection' | 'book';
    files: PDFFile[];
};
type PDFCatalogue = {
    schema_version: number;
    draft_version: string;
    groups: { id: string; title: string }[];
    editions: { id: string; label: string; entries: PDFEntry[] }[];
};
const catalogue = downloadCatalogue as PDFCatalogue;
if (catalogue.schema_version !== 2)
    throw new Error('Unsupported PDF download catalogue version');
const displayTitle = (entry: PDFEntry) =>
    entry.kind === 'book' ? `${entry.title} (${entry.id})` : entry.title;
const size = (file: PDFFile) => `${(file.bytes / 1048576).toFixed(1)} MB`;
const editions = catalogue.editions.map((edition) => ({
    ...edition,
    sections: [
        {
            title: 'Collections',
            books: edition.entries.filter((e) => e.kind === 'collection'),
            expandable: false,
        },
        ...catalogue.groups.map((group) => ({
            title: group.title,
            books: edition.entries.filter(
                (e) => e.kind === 'book' && e.group === group.id,
            ),
            expandable: true,
        })),
    ],
}));
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Page from '../../components/Page.astro';
import MainPageContent from '../../components/MainPageContent.astro';
---

<Base title="Downloads - Open English Translation">
    <Header />
    <main class="main">
        <Page
            ><MainPageContent>
                <h1>Downloads</h1>
                <h2 id="pdfs">PDFs for reading and printing</h2>
                <p>
                    Take the Open English Translation with you: save a book to
                    your device, read a whole collection offline, or print a
                    copy to share. Start with the Readers’ Version for everyday
                    reading, or choose the parallel edition to explore the
                    Literal Version alongside it.
                </p>
                <nav aria-label="Choose a PDF edition" class="edition-links">
                    <a href="#OET-RV">
                        <strong>Read the Readers’ Version</strong>
                        <span
                            >Natural English, with a familiar two-column layout.</span
                        >
                    </a>
                    <a href="#OET">
                        <strong>Explore the parallel edition</strong>
                        <span
                            >Read the RV and consult the smaller LV beside it.</span
                        >
                    </a>
                </nav>
                <p class="download-note">
                    These are draft {catalogue.draft_version} PDFs in OET book order.
                    The colour B5 files suit screen reading; the black-and-white print
                    files come in B5, A4 and Letter. All links are clickable, and
                    print copies show full web addresses. For paper copies, print
                    at actual size on both sides, with long-edge binding.
                </p>
                <p class="download-note">
                    Downloads are served by <a
                        href="https://Freely-Given.org/OBD/OET/Downloads/index.htm#Top"
                        >Open Bible Data</a
                    >. The deuterocanonical and other books are early drafts:
                    parallel editions pair them by chapter, so their verses and
                    lines may differ. Each PDF notes any unavailable version;
                    RV-only downloads contain the books available in the RV.
                </p>
                {
                    editions.map((edition) => (
                        <section class="pdf-edition" id={edition.id}>
                            <h2>{edition.label}</h2>
                            <p class="edition-description">
                                {edition.id === 'OET-RV'
                                    ? 'An uninterrupted English reading experience, with introductions and notes.'
                                    : 'Two complementary translations, with matched sections to help you compare as you read.'}
                            </p>
                            {edition.sections.map((section) => {
                                const Wrapper = section.expandable
                                    ? 'details'
                                    : 'div';
                                return (
                                    <Wrapper>
                                        {section.expandable ? (
                                            <summary>
                                                {section.title} ·{' '}
                                                {section.books.length} books
                                            </summary>
                                        ) : (
                                            <h3>Choose a collection</h3>
                                        )}
                                        <ul class="download-cards">
                                            {section.books.map((entry) => (
                                                <li class="download-card">
                                                    <h4>
                                                        {displayTitle(entry)}
                                                    </h4>
                                                    {(
                                                        [
                                                            'screen',
                                                            'print',
                                                        ] as const
                                                    ).map((medium) => (
                                                        <div class="download-format">
                                                            <p class="format-label">
                                                                {medium ===
                                                                'screen'
                                                                    ? 'Read on screen'
                                                                    : 'Print a copy'}
                                                            </p>
                                                            <div class="file-options">
                                                                {entry.files
                                                                    .filter(
                                                                        (
                                                                            file,
                                                                        ) =>
                                                                            file.medium ===
                                                                            medium,
                                                                    )
                                                                    .map(
                                                                        (
                                                                            file,
                                                                        ) => (
                                                                            <div class="pdf-choice">
                                                                                <a
                                                                                    class={`download-link ${medium}`}
                                                                                    href={
                                                                                        file.url
                                                                                    }
                                                                                    aria-label={`${displayTitle(entry)} — ${edition.label} — ${medium === 'print' ? 'Print' : 'Online'} ${file.paper_size} PDF`}
                                                                                >
                                                                                    {
                                                                                        file.paper_size
                                                                                    }{' '}
                                                                                    PDF
                                                                                </a>
                                                                                <small>
                                                                                    {size(
                                                                                        file,
                                                                                    )}{' '}
                                                                                    ·{' '}
                                                                                    {file.pages.toLocaleString(
                                                                                        'en',
                                                                                    )}{' '}
                                                                                    pages
                                                                                </small>
                                                                            </div>
                                                                        ),
                                                                    )}
                                                            </div>
                                                        </div>
                                                    ))}
                                                </li>
                                            ))}
                                        </ul>
                                    </Wrapper>
                                );
                            })}
                        </section>
                    ))
                }
                <h2 id="paratext">Paratext backups</h2>
                <p>
                    The <a href="https://paratext.org/"
                        >UBS/SIL Paratext Bible editor</a
                    > has the ability to load a project from a zip file. We provide
                    the following snapshots of the OET v0.48.78:
                </p>
                <ul>
                    <li>
                        <a href="/Paratext_backups/OET_RV_F 2026-09-14.zip"
                            >Readers’ Version (full version)</a
                        >
                    </li>
                    <li>
                        <a href="/Paratext_backups/OET_RV_E 2026-09-14.zip"
                            >Readers’ Version (without word numbers, etc.)</a
                        >
                    </li>
                    <li>
                        <a href="/Paratext_backups/OET_LV_F 2026-09-14.zip"
                            >Literal Version (full version)</a
                        >
                    </li>
                    <li>
                        <a href="/Paratext_backups/OET_LV_E 2026-09-14.zip"
                            >Literal Version (without word numbers, etc.)</a
                        >
                    </li>
                </ul>
                <h2 id="source">Source files</h2>
                <p>
                    The in-progress source files of the <em>OET</em> are <a
                        href="https://github.com/Freely-Given-org/ESFM">ESFM</a
                    > (enhanced <a
                        href="https://docs.usfm.bible/usfm/latest/index.html"
                        >USFM</a
                    >) and associated ESFM data tables are <a
                        href="https://en.Wikipedia.org/wiki/Tab-separated_values"
                        >TSV</a
                    >. These can be downloaded from the <a
                        href="https://GitHub.com/Freely-Given-org/OpenEnglishTranslation--OET"
                        >project repository</a
                    >.
                </p>
            </MainPageContent>
        </Page>
    </main>
    <Footer />
</Base>

<style>
    .main {
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .main :global(.main-page-content) {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
    }
    .edition-links {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin: 1.5rem 0;
    }
    .edition-links a {
        display: block;
        border-left: 4px solid var(--accent-orange);
        background: #faf6ed;
        padding: 1rem 1.2rem;
        text-decoration: none;
    }
    .edition-links strong,
    .edition-links span {
        display: block;
    }
    .edition-links span {
        margin-top: 0.4rem;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
    }
    .pdf-edition {
        margin: 3rem 0;
        scroll-margin-top: 1rem;
    }
    .pdf-edition .edition-description,
    .main .download-note {
        font-size: 1rem;
        line-height: 1.5;
    }
    .pdf-edition .download-cards {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        list-style: none;
        margin: 1rem 0 1.5rem;
        padding: 0;
    }
    .download-card {
        border: 1px solid #ddd5c7;
        border-radius: 0.5rem;
        padding: 1.2rem;
        background: #fffdf8;
        min-width: 0;
    }
    .download-card h4 {
        margin: 0 0 1rem;
        font-size: 1.15rem;
        line-height: 1.4;
    }
    .download-format + .download-format {
        margin-top: 1rem;
        border-top: 1px solid #e8e1d5;
        padding-top: 0.8rem;
    }
    .download-card .format-label {
        margin: 0 0 0.6rem;
        font-size: 0.85rem;
        font-weight: 600;
    }
    .file-options {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
    }
    .pdf-choice {
        flex: 1 1 6.5rem;
    }
    .pdf-edition .download-link {
        display: inline-block;
        border: 1px solid var(--medium-blue);
        border-radius: 0.3rem;
        padding: 0.4rem 0.65rem;
        text-decoration: none;
        font-size: 0.95rem;
    }
    .pdf-edition .download-link.screen {
        color: white;
        background: var(--medium-blue);
    }
    .pdf-edition .download-link:hover {
        outline: 2px solid var(--accent-orange);
        outline-offset: 2px;
    }
    .pdf-choice small {
        display: block;
        margin-top: 0.4rem;
        font-size: 0.8rem;
        line-height: 1.4;
    }
    .pdf-edition details {
        border-top: 1px solid #ddd5c7;
        padding: 0.5rem 0;
    }
    .pdf-edition summary {
        cursor: pointer;
        font-weight: 600;
        padding: 0.7rem 0;
    }
    @media (max-width: 680px) {
        .edition-links,
        .pdf-edition .download-cards {
            grid-template-columns: 1fr;
        }
    }
</style>
