---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Page from '../../../components/Page.astro';
import MainPageContent from '../../../components/MainPageContent.astro';
import type { MarkdownInstance } from 'astro';

interface Essay {
    title: string;
    date: string | null;
    dateLabel: string | null;
    updated?: string;
    updatedLabel?: string;
    legacyId?: string;
}

const essays = Object.values(
    import.meta.glob<MarkdownInstance<Essay>>('./*.md', { eager: true }),
).map(({ frontmatter, url }) => ({ ...frontmatter, url }));

const datedEssays = essays
    .filter((essay) => essay.date)
    .sort(
        (a, b) =>
            b.date!.localeCompare(a.date!) || a.title.localeCompare(b.title),
    );
const undatedEssays = essays
    .filter((essay) => !essay.date)
    .sort((a, b) => a.title.localeCompare(b.title));
---

<Base title="Blog - Open English Translation">
    <Header />
    <main
        style={{
            minHeight: '85vh',
            display: 'flex',
            flexDirection: 'column',
            alignItems: 'center',
        }}
    >
        <Page>
            <MainPageContent>
                <h1>Blog and short essays</h1>
                <p>
                    Thoughts on Bible translation and the Open English
                    Translation, including the booklet <em
                        >A collection of short essays</em
                    >. Dates are those given by the author, with later revisions
                    noted separately. Essays without a date in the booklet are
                    listed below.
                </p>
                <nav class="essay-index" aria-label="Essay index">
                    <h2>Dated essays</h2>
                    <ul>
                        {
                            datedEssays.map((essay) => (
                                <li>
                                    <a
                                        href={essay.url}
                                        id={essay.legacyId}
                                        data-legacy-post={essay.legacyId}
                                    >
                                        {essay.title}
                                    </a>
                                    {' — '}
                                    <time datetime={essay.date!}>
                                        {essay.dateLabel}
                                    </time>
                                    {essay.updated && (
                                        <>
                                            {' '}
                                            (updated{' '}
                                            <time datetime={essay.updated}>
                                                {essay.updatedLabel}
                                            </time>
                                            )
                                        </>
                                    )}
                                </li>
                            ))
                        }
                    </ul>
                    <h2>Undated essays</h2>
                    <ul>
                        {
                            undatedEssays.map((essay) => (
                                <li>
                                    <a href={essay.url}>{essay.title}</a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>
                <p>
                    The booklet essay <em>Which word?</em> already has an expanded
                    version here: <a href="/Discussion/Blog/which-word/"
                        >Which 'word'?</a
                    >.
                </p>
            </MainPageContent>
        </Page>
    </main>
    <Footer />
</Base>

<style>
    .essay-index {
        margin-block: 1.5rem;
    }
    .essay-index ul {
        padding-left: 1.5rem;
        list-style-position: outside;
    }
    .essay-index li {
        margin-block: 0.5rem;
    }
    [data-legacy-post] {
        scroll-margin-top: 6rem;
    }
</style>

<script>
    // Fragments never reach the server. Keep old shared links working in the
    // browser, with the anchored index links as a fallback without JavaScript.
    function followLegacyBlogLink() {
        const link = document.getElementById(window.location.hash.slice(1));
        if (
            link instanceof HTMLAnchorElement &&
            link.hasAttribute('data-legacy-post')
        ) {
            window.location.replace(link.href);
        }
    }

    followLegacyBlogLink();
    window.addEventListener('hashchange', followLegacyBlogLink);
</script>
